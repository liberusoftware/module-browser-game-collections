{
    "name": "liberusoftware/package-testbench",
    "description": "Shared test bootstrap and boundary suites for Liberu module, theme and contract packages.",
    "version": "1.8.0",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.5",
        "orchestra/testbench": "^11.1",
        "pestphp/pest": "^5.0",
        "laravel/pint": "^1.14",
        "larastan/larastan": "^3.0"
    },
    "autoload": {
        "psr-4": {
            "Liberu\\PackageTestbench\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Liberu\\PackageTestbench\\Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    }
}
